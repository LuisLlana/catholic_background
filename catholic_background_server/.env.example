# Copy to /etc/catholic-background/env (or .env for development) and fill in.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=simba.fdi.ucm.es
CSRF_TRUSTED_ORIGINS=https://simba.fdi.ucm.es
DEBUG=false

# Base path: the image is served at https://HOST/background and everything else
# hangs from it (/background/admin/, /background/home/...)
BASE_PATH=background

# Database (SQLite by default). PostgreSQL / MariaDB:
#DATABASE_URL=postgres://catholic:password@localhost/catholic
#DATABASE_URL=mysql://catholic:password@localhost/catholic
DATA_DIR=/var/lib/catholic-background

# Login with e-mail and password (accounts created by an administrator).
# If not set: enabled only while no Google/Microsoft login is configured.
#PASSWORD_LOGIN=true

# Login with Google and Microsoft. See README: "Google and Microsoft login".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Administrators (e-mails, comma separated) and domains whose users become editors automatically
ADMIN_EMAILS=luis.llana.diaz@gmail.com
AUTO_APPROVE_DOMAINS=

# Label below the artwork (reason, title, author); applications can ask caption=0
#CAPTION_DEFAULT=true

# Privacy page
PRIVACY_CONTROLLER=Luis Llana
PRIVACY_CONTACT=luis.llana.diaz@gmail.com
ACCESS_LOG_DAYS=30
