[Unit]
Description=Image of the day on the login screen (Catholic Background)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/catholic-background-gtk/login.conf

[Service]
Type=oneshot
ExecStart=/usr/libexec/catholic-background-gtk/login-background update
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/catholic-background-gtk
