# Copy to /etc/catholic-background/env (or .env for development) and fill in.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=simba.fdi.ucm.es
CSRF_TRUSTED_ORIGINS=https://simba.fdi.ucm.es
DEBUG=false

# Database (SQLite by default). PostgreSQL / MariaDB:
#DATABASE_URL=postgres://catholic:password@localhost/catholic
#DATABASE_URL=mysql://catholic:password@localhost/catholic
DATA_DIR=/var/lib/catholic-background

# Login (no passwords). See README: "Google and Microsoft login".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Administrators (e-mails, comma separated) and domains whose users become editors automatically
ADMIN_EMAILS=luis.llana.diaz@gmail.com
AUTO_APPROVE_DOMAINS=

# Privacy page
PRIVACY_CONTROLLER=Luis Llana
PRIVACY_CONTACT=luis.llana.diaz@gmail.com
ACCESS_LOG_DAYS=30
