export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Default server URL compiled into the plugin. Override it with:
#     WALLPAPER_URL=https://my-server.example/background dpkg-buildpackage -us -uc -b
WALLPAPER_URL ?= https://simba.fdi.ucm.es/background

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
		-DBUILD_TESTING=OFF \
		-DWALLPAPER_URL="$(WALLPAPER_URL)"

# libplasmapotdprovidercore is a private library of kdeplasma-addons without
# shlibs information; the dependency is declared by hand in debian/control.
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
