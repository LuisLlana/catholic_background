[Unit]
Description=Check for a new Catholic background of the day
PartOf=graphical-session.target
After=plasma-workspace.target

[Service]
Type=oneshot
ExecStart=@KDE_INSTALL_FULL_BINDIR@/catholic-background-settings --update
