#
# Identity of the MSIX package. For the Microsoft Store, replace these values
# with the ones shown in Partner Center > your app > Product identity:
#   Package/Identity/Name              -> PACKAGE_NAME
#   Package/Identity/Publisher         -> PUBLISHER (CN=...)
#   Package/Properties/PublisherDisplayName -> PUBLISHER_DISPLAY_NAME
PACKAGE_NAME="LuisLlana.CatholicBackgroundoftheDay"
PUBLISHER="CN=Luis Llana"
PUBLISHER_DISPLAY_NAME="Luis Llana"
DISPLAY_NAME="Catholic Background of the Day"
