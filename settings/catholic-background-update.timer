[Unit]
Description=Check for a new Catholic background of the day every 30 minutes
PartOf=graphical-session.target

[Timer]
OnActiveSec=2min
OnUnitActiveSec=30min
AccuracySec=1min

[Install]
WantedBy=plasma-workspace.target
